{
  "name": "teacher-playground",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:worker",
    "dev:next": "next dev --webpack",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "next build --webpack",
    "dev:worker": "npm run build && wrangler dev",
    "dev:access": "node scripts/local-access-issuer.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:workers": "node scripts/run-worker-tests.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "r2:check": "node scripts/cloudflare-r2.mjs check",
    "r2:apply": "node scripts/cloudflare-r2.mjs apply",
    "access:check": "node scripts/cloudflare-access.mjs check",
    "access:apply": "node scripts/cloudflare-access.mjs apply-app",
    "access:branding": "node scripts/cloudflare-access.mjs apply-branding",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@teacher-playground/excalidraw": "https://github.com/EduardoSolanas/excalidraw/releases/download/teacher-playground-v0.18.1-tp.7/package.tgz",
    "better-sqlite3": "^12.10.0",
    "livekit-client": "^2.22.0",
    "next": "^16.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "uuid": "^14.0.0",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "immutable": "4.3.9",
    "mermaid": "11.16.1",
    "lodash-es": "4.18.1",
    "@teacher-playground/excalidraw": {
      "nanoid": "3.3.18",
      "sass": {
        "immutable": "4.3.9"
      }
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16",
      "@mermaid-js/parser": "1.2.0"
    }
  }
}
