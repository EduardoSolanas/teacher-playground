{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mts"
  },
  "mutate": [
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.ts"
  ],
  "coverageAnalysis": "perTest",
  "tempDir": ".stryker-tmp",
  "concurrency": 6,
  "timeoutMS": 30000,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "coverage/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/report.json"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": null
  }
}
