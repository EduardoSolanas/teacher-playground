# Whiteboard Database (SQLite - auto-created in .data/ folder)
# No configuration needed

# Optional: Vercel KV for production persistence
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# LiveKit A/V (Phase 3) — required for video/voice; omit to disable gracefully
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=secretxxxxxxxx

# Guest join hostname (client). Must match the Worker GUEST_HOSTNAME.
# NEXT_PUBLIC_GUEST_HOSTNAME=join.localhost
